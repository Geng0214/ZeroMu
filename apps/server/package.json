{
  "name": "@toonflow/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./desktop": "./src/types/desktop.ts",
    "./mcp": "./src/utils/mcp/runtime.ts",
    "./agent/types": "./src/agent/runtime/types.ts",
    "./agent/mentionSources": "./src/agent/mentionSources.ts",
    "./production": "./src/utils/production/schema.ts",
    "./production/batches": "./src/utils/production/batchSchema.ts",
    "./production/references": "./src/utils/production/referenceState.ts",
    "./i18n": "./src/lib/i18n.ts",
    "./skills": "./src/utils/skills/files.ts",
    "./studioDrafts": "./src/utils/studioDrafts/schema.ts",
    "./promptLibrary": "./src/utils/promptLibrary/schema.ts"
  },
  "scripts": {
    "routes": "bun src/core.ts",
    "dev": "NODE_ENV=dev bun --watch src/index.ts",
    "start:local": "NODE_ENV=dev bun src/index.ts",
    "build": "bun scripts/build.ts",
    "start": "bun ../../build/server/index.js",
    "typecheck": "tsc"
