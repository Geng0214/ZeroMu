    "@toonflow/teams-scaffold": "workspace:*",
    "@toonflow/tool-canvas": "workspace:*",
    "@toonflow/tool-media-generation": "workspace:*",
    "@toonflow/tools-scaffold": "workspace:*",
    "conf": "^15.1.0",
    "eventsource-parser": "3.1.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "morgan": "^1.12.1",
    "onnxruntime-node": "1.30.0",
    "wavefile": "^11.0.0",
